# Copia este archivo a .env.local y completa los valores reales.
# NUNCA pongas valores reales aquí — este archivo SÍ se sube a git.

# Supabase — públicas (protegidas por RLS, no por secreto)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase — secreta (SOLO servidor, nunca con prefijo NEXT_PUBLIC_)
SUPABASE_SECRET_KEY=

# Hotmart — secreta (verifica que el aviso de pago venga de Hotmart de verdad)
HOTMART_HOTTOK=

# Hotmart — públicas (links de checkout de cada plan, para el botón del paywall)
NEXT_PUBLIC_HOTMART_CHECKOUT_MENSUAL=
NEXT_PUBLIC_HOTMART_CHECKOUT_ANUAL=

# Resend — secreta (envío de emails transaccionales)
RESEND_API_KEY=

# URL pública final del sitio (para links de email, redirects de Auth, etc.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
